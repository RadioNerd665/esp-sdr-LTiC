cmake_minimum_required(VERSION 3.16)

macro(idf_build_get_property result property)
    set(${result} "")
endmacro()

macro(idf_component_register)
    cmake_parse_arguments(component "" "" "SRCS;LDFRAGMENTS;PRIV_INCLUDE_DIRS;REQUIRES" ${ARGN})
    set(component_seen TRUE)
    return()
endmacro()

include("${CMAKE_CURRENT_LIST_DIR}/../main/CMakeLists.txt")
if(NOT component_seen)
    message(FATAL_ERROR "Component registration not reached")
endif()

foreach(dependency esp_eth esp_netif esp_http_server lwip)
    if(IDF_TARGET STREQUAL "esp32")
        if(NOT dependency IN_LIST component_REQUIRES)
            message(FATAL_ERROR "ESP32 is missing dependency ${dependency}")
        endif()
    elseif(dependency IN_LIST component_REQUIRES)
        message(FATAL_ERROR "${IDF_TARGET} unexpectedly requires ${dependency}")
    endif()
endforeach()

if(CONFIG_ESP_SDR_LILYGO)
    if(NOT "targets/esp32/lilygo_network.c" IN_LIST component_SRCS)
        message(FATAL_ERROR "LilyGO backend missing from enabled profile")
    endif()
elseif("targets/esp32/lilygo_network.c" IN_LIST component_SRCS)
    message(FATAL_ERROR "LilyGO backend present when profile is disabled")
endif()
